# ==============================================================================
# ReviewFlow — Environment Configuration Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API (Required)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Security: This key is used strictly server-side and never exposed to the client.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model variant (Default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# ------------------------------------------------------------------------------
# 2. Business Review Integration (Recommended)
# Direct link to your Google Maps "Write a review" modal.
# Example: https://www.google.com/search?q=your+business+name#lrd=...
# Customers are redirected here with one tap after copying their drafted review.
# ------------------------------------------------------------------------------
GOOGLE_REVIEW_URL=https://www.google.com/search?q=your+business+name#lrd=...

# ------------------------------------------------------------------------------
# 3. Optional Backend Proxy Configuration
# Set USE_FLASK_BACKEND=true only if you want Next.js to proxy review generation
# requests to a standalone Python Flask service instead of calling Gemini directly.
# ------------------------------------------------------------------------------
USE_FLASK_BACKEND=false
FLASK_API_URL=http://127.0.0.1:5000

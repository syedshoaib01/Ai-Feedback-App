# ==============================================================================
# ReviewFlow — Environment Configuration Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API (Required)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Security: This key is used strictly server-side and never exposed to the client.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model variant (Default: gemini-3.5-flash)
# Options: gemini-3.5-flash, gemini-3.7-flash
GEMINI_MODEL=gemini-3.5-flash

# ------------------------------------------------------------------------------
# 2. Business Review Integration (Recommended)
# Direct link to your Google Maps "Write a review" modal.
# Example: https://www.google.com/search?q=your+business+name#lrd=...
# Customers are redirected here with one tap after copying their drafted review.
# ------------------------------------------------------------------------------
GOOGLE_REVIEW_URL=https://www.google.com/search?q=your+business+name#lrd=...

# ------------------------------------------------------------------------------
# 3. Distributed Rate Limiting (Required for Production Vercel Deployments)
# Upstash Redis REST credentials for multi-instance distributed rate limiting
# (15 requests per 10 minutes per client IP).
# In local development (NODE_ENV !== "production"), ReviewFlow falls back to
# an in-memory sliding window when omitted.
# In production (NODE_ENV === "production"), these variables are REQUIRED.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
